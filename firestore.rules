rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{questionId} {
      // Anyone can read interview questions
      allow read: if true;

      // Anyone can submit a question with required fields
      allow create: if request.resource.data.companyName is string
                    && request.resource.data.interviewStage is string
                    && request.resource.data.question is string
                    && request.resource.data.answer is string
                    && request.resource.data.helpfulCount is number
                    && request.resource.data.createdAt is number;

      // Anyone can increment helpful count
      allow update: if request.resource.data.helpfulCount is number;

      allow delete: if false;
    }
  }
}
