rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{questionId} {
      // Only authenticated users can read interview questions
      allow read: if request.auth != null;

      // Only authenticated users can submit a question with required fields
      allow create: if request.auth != null
                    && request.resource.data.companyName is string
                    && request.resource.data.interviewStage is string
                    && request.resource.data.question is string
                    && request.resource.data.answer is string
                    && request.resource.data.helpfulCount is number
                    && request.resource.data.createdAt is number;

      // Only authenticated users can increment helpful count
      allow update: if request.auth != null
                    && request.resource.data.helpfulCount is number;

      allow delete: if false;
    }
  }
}
